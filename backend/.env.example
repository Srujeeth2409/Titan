ENVIRONMENT=development
POSTGRES_DSN=postgresql+asyncpg://titan:titan@postgres:5432/titan
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGIN=http://localhost:3000
# Local Docker Postgres is published on 5433 (see docker-compose.yml)
# POSTGRES_DSN=postgresql+asyncpg://titan:titan@localhost:5433/titan
LOG_INGEST_API_KEY=dev-log-ingest-key-change-me
DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_COLLECTION=default
NEXT_PUBLIC_API_URL=http://localhost:8000
